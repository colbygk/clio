#!/usr/bin/env bash
# clusterctl — one command (run on ceres) to operate the clio/urania DGX Spark cluster.
#
#   clusterctl bootstrap            full first-time setup of both nodes (idempotent)
#   clusterctl preflight [node]     what bootstrap checks first: deploy safety + dirty working tree
#   clusterctl status               health of nodes, GPUs, services, fabric
#   clusterctl models               list available model profiles
#   clusterctl serve <profile>      SCALE-OUT: run a model on each node, load-balanced
#   clusterctl shard <profile>      SCALE-UP: run one big model across both nodes (PP=2)
#   clusterctl down                 stop all model serving
#   clusterctl use <model>          point THIS machine's Claude Code at a gateway model
#   clusterctl mode <node> [role]   show/set a node's role: llm | comfy | off (they are exclusive)
#   clusterctl comfyui up|down      start/stop ComfyUI on both nodes
#   clusterctl nginx deploy|status  HTTPS + mutual-TLS front door for ComfyUI (certs from clio-pki)
#   clusterctl lan-mtu <mtu> [node] change management-LAN MTU, verified before it is persisted
#   clusterctl nccl-test            verify RoCE bandwidth + NCCL data path across the fabric
#   clusterctl logs <svc> [node]    tail a service log (vllm|gateway|comfyui|shard)
#
set -euo pipefail
# Resolve through symlinks (clusterctl is symlinked into ~/.local/bin) to find the real repo.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"; SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
REPO_ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
. "$REPO_ROOT/cluster/inventory.env"

# The SSH key path contains spaces ("Application Support"), which rsync's -e cannot parse.
# Route through a spaceless symlink so both ssh and rsync work.
mkdir -p "$HOME/.clio"
KEYLINK="$HOME/.clio/nvsync.key"
[ -e "$KEYLINK" ] || ln -sf "$SSH_KEY" "$KEYLINK"
SSH_KEY="$KEYLINK"

NODES=("$CLIO_MGMT" "$URANIA_MGMT")
SSH_OPTS=(-i "$SSH_KEY" -o StrictHostKeyChecking=accept-new -o ConnectTimeout=8)
on()    { local h=$1; shift; ssh "${SSH_OPTS[@]}" "$SSH_USER@$h" "$@"; }
on_t()  { local h=$1; shift; ssh -t "${SSH_OPTS[@]}" "$SSH_USER@$h" "$@"; }
sudosh(){ local h=$1; shift; on "$h" "sudo bash -c '$*'"; }   # passwordless after bootstrap
say()   { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
err()   { printf '\033[1;31mERROR:\033[0m %s\n' "$*" >&2; }
warn()  { printf '\033[1;33mWARN:\033[0m %s\n' "$*" >&2; }
die()   { err "$*"; exit 1; }

# Directories that live inside /opt/clio but are NOT part of this repo — the bootstrap scripts
# git-clone them there. comfyui-docker holds the entire ComfyUI basedir: models, LoRAs, custom
# nodes, workflows. A repo sync uses --delete, which counts them as extraneous. ONE list, used both
# to build the rsync excludes and to check that nothing else has appeared needing the same cover.
RSYNC_PROTECT=(comfyui-docker spark-vllm-docker)

protect_args() { local p; for p in "${RSYNC_PROTECT[@]}"; do printf -- '--exclude=%s/ ' "$p"; done; }

# Structural guard, rather than a list somebody has to remember to update.
#
# Refuse to sync when /opt/clio holds something irreplaceable that is NOT on the protect list:
#   - a mountpoint — deleting through one destroys data on the node that EXPORTS it. clio's
#     basedir/models is an NFS mount of urania, so a careless sync to clio could wipe urania.
#   - a git checkout — a working tree this repo cannot reconstruct.
# A future bootstrap script that clones somewhere new gets caught here instead of silently wiped.
check_dest_safe() {
  local h=$1 report kind path top p protected bad=0
  report=$(on "$h" 'for d in /opt/clio/*/; do [ -d "$d/.git" ] && echo "git ${d%/}"; done
                    findmnt -rn -o TARGET 2>/dev/null | grep "^/opt/clio/" | sed "s|^|mount |"' 2>/dev/null) || return 0
  while read -r kind path; do
    [ -n "${kind:-}" ] || continue
    top=${path#/opt/clio/}; top=${top%%/*}
    protected=0
    for p in "${RSYNC_PROTECT[@]}"; do [ "$p" = "$top" ] && protected=1; done
    if [ "$protected" = 0 ]; then
      err "[$h] /opt/clio/$top is a $kind, and --delete would remove it"
      bad=1
    fi
  done <<< "$report"
  [ "$bad" = 0 ] || die "Refusing to sync. Add it to RSYNC_PROTECT in bin/clusterctl first.
   (Deleting through an NFS mount destroys the data on the node exporting it.)"
}

# bootstrap deploys the WORKING TREE, not HEAD. That is deliberate — it is what lets you test an
# edit before committing — but it is also how the gateway's split routing ran on the nodes for
# seven weeks while the repo described load-balanced routing. Say so out loud.
check_repo_clean() {
  git -C "$REPO_ROOT" rev-parse --git-dir >/dev/null 2>&1 || return 0
  local dirty
  dirty=$(git -C "$REPO_ROOT" status --porcelain -- cluster scripts 2>/dev/null)
  [ -n "$dirty" ] || return 0
  err "Uncommitted changes in the files bootstrap deploys:"
  printf '%s\n' "$dirty" | sed 's/^/       /' >&2
  err "These will be deployed and CANNOT be reproduced from git by anyone else."
  [ "${CLIO_ALLOW_DIRTY:-0}" = 1 ] && { say "CLIO_ALLOW_DIRTY=1 set — continuing."; return 0; }
  if [ -t 0 ]; then
    local a; read -r -p "$(printf '\033[1;33mDeploy uncommitted changes anyway? [y/N] \033[0m')" a
    case "$a" in y|Y|yes|YES) return 0;; *) die "Stopped. Commit first, or set CLIO_ALLOW_DIRTY=1.";; esac
  fi
  warn "Not a terminal — continuing, but commit these."
}

rsync_repo() {
  local h=$1
  say "Syncing repo -> $h:/opt/clio"
  on "$h" "sudo mkdir -p /opt/clio && sudo chown $SSH_USER:$SSH_USER /opt/clio"
  check_dest_safe "$h"
  # cluster/* flattens into /opt/clio (so /opt/clio/run, /opt/clio/gateway, /opt/clio/nccl.env ...)
  # shellcheck disable=SC2046  # word-splitting of protect_args is intended
  rsync -az --delete -e "ssh ${SSH_OPTS[*]}" \
    --exclude 'gateway.env' --exclude 'active-profile.env' --exclude 'shard-profile.env' \
    $(protect_args) \
    "$REPO_ROOT/cluster/" "$SSH_USER@$h:/opt/clio/"
  rsync -az --delete -e "ssh ${SSH_OPTS[*]}" \
    "$REPO_ROOT/scripts" "$SSH_USER@$h:/opt/clio/"
  on "$h" "chmod +x /opt/clio/scripts/bootstrap/*.sh /opt/clio/run/*.sh 2>/dev/null || true"
}

# What bootstrap would check before touching anything. Safe to run any time.
cmd_preflight() {
  local which=${1:-all} hosts=("${NODES[@]}")
  case "$which" in clio) hosts=("$CLIO_MGMT");; urania) hosts=("$URANIA_MGMT");; all) ;; *) die "preflight [clio|urania]";; esac
  say "Protected from --delete: ${RSYNC_PROTECT[*]}"
  for h in "${hosts[@]}"; do
    check_dest_safe "$h" && say "[$h] destination safe"
  done
  local dirty
  dirty=$(git -C "$REPO_ROOT" status --porcelain -- cluster scripts 2>/dev/null)
  if [ -n "$dirty" ]; then
    warn "Working tree is dirty in deployed paths (bootstrap would deploy these uncommitted):"
    printf '%s\n' "$dirty" | sed 's/^/       /' >&2
  else
    say "Working tree clean in deployed paths — the nodes would match git"
  fi
}

ensure_passwordless_sudo() {
  local h=$1
  if on "$h" 'sudo -n true' 2>/dev/null; then return 0; fi
  say "Enabling passwordless sudo on $h (one-time; you'll be prompted for the sudo password)"
  on_t "$h" 'echo "'"$SSH_USER"' ALL=(ALL) NOPASSWD:ALL" | sudo tee /etc/sudoers.d/90-clio-nopasswd >/dev/null && sudo chmod 440 /etc/sudoers.d/90-clio-nopasswd && sudo usermod -aG docker '"$SSH_USER"
}

ensure_node_ssh() {
  # Passwordless SSH between the two nodes (needed by launch-cluster.sh in shard mode).
  if on "$CLIO_MGMT" "ssh -o BatchMode=yes -o ConnectTimeout=5 $URANIA_FABRIC hostname" >/dev/null 2>&1; then
    return 0
  fi
  say "Setting up node<->node passwordless SSH over the fabric"
  on "$CLIO_MGMT"   'test -f ~/.ssh/id_ed25519 || ssh-keygen -t ed25519 -N "" -f ~/.ssh/id_ed25519'
  on "$URANIA_MGMT" 'test -f ~/.ssh/id_ed25519 || ssh-keygen -t ed25519 -N "" -f ~/.ssh/id_ed25519'
  local cpk upk
  cpk=$(on "$CLIO_MGMT" 'cat ~/.ssh/id_ed25519.pub')
  upk=$(on "$URANIA_MGMT" 'cat ~/.ssh/id_ed25519.pub')
  on "$URANIA_MGMT" "grep -qF '$cpk' ~/.ssh/authorized_keys 2>/dev/null || echo '$cpk' >> ~/.ssh/authorized_keys"
  on "$CLIO_MGMT"   "grep -qF '$upk' ~/.ssh/authorized_keys 2>/dev/null || echo '$upk' >> ~/.ssh/authorized_keys"
  # Trust fabric host keys to avoid prompts.
  on "$CLIO_MGMT"   "ssh-keyscan -H $URANIA_FABRIC >> ~/.ssh/known_hosts 2>/dev/null || true"
  on "$URANIA_MGMT" "ssh-keyscan -H $CLIO_FABRIC   >> ~/.ssh/known_hosts 2>/dev/null || true"
}

cmd_bootstrap() {
  check_repo_clean
  for h in "${NODES[@]}"; do ensure_passwordless_sudo "$h"; done
  ensure_node_ssh
  for h in "${NODES[@]}"; do rsync_repo "$h"; done
  for h in "${NODES[@]}"; do
    say "[$h] 00-common";  on "$h" 'sudo CLUSTER_DIR=/opt/clio bash /opt/clio/scripts/bootstrap/00-common.sh'
    say "[$h] 10-network"; on "$h" 'sudo CLUSTER_DIR=/opt/clio bash /opt/clio/scripts/bootstrap/10-network.sh'
    say "[$h] 20-vllm (LONG build)"; on "$h" 'sudo CLUSTER_DIR=/opt/clio bash /opt/clio/scripts/bootstrap/20-vllm.sh'
    say "[$h] 30-comfyui"; on "$h" 'sudo CLUSTER_DIR=/opt/clio bash /opt/clio/scripts/bootstrap/30-comfyui.sh'
  done
  # 35 is ordered, not per-node: the store host must be exporting before the other node mounts it.
  local store other
  store=$(resolve_node "$COMFY_STORE_HOST")
  other=$([ "$store" = "$CLIO_MGMT" ] && echo "$URANIA_MGMT" || echo "$CLIO_MGMT")
  for h in "$store" "$other"; do
    say "[$h] 35-comfyui-share"; on "$h" 'sudo CLUSTER_DIR=/opt/clio bash /opt/clio/scripts/bootstrap/35-comfyui-share.sh'
  done
  say "[$HEAD] 40-gateway"; on "$HEAD" 'sudo CLUSTER_DIR=/opt/clio bash /opt/clio/scripts/bootstrap/40-gateway.sh'
  say "Bootstrap complete. Next: clusterctl serve local-coder && clusterctl use local-coder"
}

profile_path() { echo "$REPO_ROOT/cluster/profiles/$1.env"; }

cmd_serve() {       # scale-out
  local prof=$1 pf; pf=$(profile_path "$prof"); [ -f "$pf" ] || die "no profile '$prof' (see: clusterctl models)"
  grep -q '^PROFILE_MODE=scaleout' "$pf" || die "'$prof' is not a scaleout profile (use: clusterctl shard $prof)"
  say "Serving '$prof' on both nodes (scale-out)"
  on "$HEAD" 'sudo systemctl stop clio-vllm-shard 2>/dev/null || true'
  for h in "${NODES[@]}"; do
    { cat "$pf"; echo "VLLM_PORT=${VLLM_PORT}"; } | on "$h" 'cat > /tmp/active-profile.env && sudo mv /tmp/active-profile.env /opt/clio/active-profile.env'
    on "$h" 'sudo systemctl restart clio-vllm'
  done
  say "Started. Watch load: clusterctl logs vllm clio   |   endpoint stays http://$HEAD:${GATEWAY_PORT}"
}

cmd_shard() {       # scale-up
  local prof=$1 pf; pf=$(profile_path "$prof"); [ -f "$pf" ] || die "no profile '$prof'"
  grep -q '^PROFILE_MODE=shard' "$pf" || die "'$prof' is not a shard profile"
  say "Sharding '$prof' across both nodes (PP=2). Stopping scale-out servers first."
  for h in "${NODES[@]}"; do on "$h" 'sudo systemctl stop clio-vllm 2>/dev/null || true'; done
  { cat "$pf"; echo "VLLM_PORT=${VLLM_PORT}"; } | on "$HEAD" 'cat > /tmp/shard-profile.env && sudo mv /tmp/shard-profile.env /opt/clio/shard-profile.env'
  on "$HEAD" 'sudo systemctl restart clio-vllm-shard'
  say "Sharded server starting on $HEAD (spans urania over the fabric). Logs: clusterctl logs shard"
}

cmd_down() {
  for h in "${NODES[@]}"; do on "$h" 'sudo systemctl stop clio-vllm 2>/dev/null || true'; done
  on "$HEAD" 'sudo systemctl stop clio-vllm-shard 2>/dev/null || true'
  say "All model serving stopped (gateway left running)."
}

cmd_use() {
  local model=$1
  mkdir -p "$HOME/.clio"
  # Spillover: hand Claude Code back to your Max subscription (its normal login) — no API key,
  # no per-token cost. Just clear the gateway env so Claude Code uses stored OAuth creds.
  if [ "$model" = "claude" ] || [ "$model" = "max" ]; then
    cat > "$HOME/.clio/claude-code.env" <<'EOF'
# Spillover mode: use your Claude Max subscription (Claude Code's normal login).
unset ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN ANTHROPIC_MODEL ANTHROPIC_SMALL_FAST_MODEL
EOF
    say "Claude Code -> your Max subscription (no API key, no metered cost)."
    echo "   Activate in the shell you run 'claude' from:  source ~/.clio/claude-code.env"
    return
  fi
  # Local models via the Spark gateway.
  local key; key=$(on "$HEAD" 'grep LITELLM_MASTER_KEY /opt/clio/gateway/gateway.env | cut -d= -f2-') || die "gateway not set up yet"
  cat > "$HOME/.clio/claude-code.env" <<EOF
# Source this to point Claude Code at the clio cluster (local Spark models).
export ANTHROPIC_BASE_URL="http://${HEAD}:${GATEWAY_PORT}"
export ANTHROPIC_AUTH_TOKEN="${key}"
export ANTHROPIC_MODEL="${model}"
export ANTHROPIC_SMALL_FAST_MODEL="${model}"
EOF
  say "Claude Code -> local model '$model'. Activate now:  source ~/.clio/claude-code.env"
  echo "   Spill over to your Max plan anytime:  clusterctl use claude"
}

resolve_node() {
  case "$1" in
    clio)   echo "$CLIO_MGMT";;
    urania) echo "$URANIA_MGMT";;
    *)      die "unknown node '$1' (clio|urania)";;
  esac
}

# A node has ONE unified-memory pool shared by CPU and GPU, so it hosts exactly one memory-hungry
# role at a time.
#
# The units declare Conflicts= on each other, which guarantees the two can never STAY up together
# — but Conflicts= carries no ordering, so on a bare `systemctl start` the incoming role begins
# while the outgoing one is still shutting down. vLLM checks free unified memory at startup and
# crash-loops if it is short, so that overlap is a real failure mode. Here we stop the outgoing
# role synchronously first (systemctl stop blocks until the unit is down, and the vLLM unit's
# ExecStop gives docker up to 60s to release the model) and only then start the incoming one.
# Conflicts= stays as the safety net for anyone driving systemctl directly.
cmd_mode() {
  local name=${1:?"mode <clio|urania> [llm|comfy|off]"} role=${2:-} node
  node=$(resolve_node "$name")
  case "$role" in
    llm)
      say "$name -> llm (stopping ComfyUI first, then starting clio-vllm)"
      on "$node" 'sudo systemctl stop clio-comfyui; sudo systemctl reset-failed clio-comfyui 2>/dev/null; sudo systemctl start clio-vllm'
      say "Model comes from /opt/clio/active-profile.env. Cold start is slow — clusterctl logs vllm $name";;
    comfy)
      say "$name -> comfy (stopping vLLM first, then starting clio-comfyui)"
      on "$node" 'sudo systemctl stop clio-vllm clio-vllm-shard; sudo systemctl reset-failed clio-vllm clio-vllm-shard 2>/dev/null; sudo systemctl start clio-comfyui'
      say "ComfyUI at http://$node:${COMFYUI_PORT} (LAN only — never port-forward it)";;
    off)
      say "$name -> off (stopping both roles, freeing the memory pool)"
      on "$node" 'sudo systemctl stop clio-comfyui clio-vllm clio-vllm-shard 2>/dev/null || true';;
    "")
      ;;   # fall through to the status readout below
    *) die "mode <clio|urania> [llm|comfy|off]";;
  esac
  printf '\033[1;36m==>\033[0m %s: ' "$name"
  on "$node" 'v=$(systemctl is-active clio-vllm); s=$(systemctl is-active clio-vllm-shard); c=$(systemctl is-active clio-comfyui)
              if [ "$c" = active ]; then echo "comfy"; elif [ "$v" = active ] || [ "$s" = active ]; then echo "llm"; else echo "off"; fi'
}

cmd_comfyui() {
  local action=${1:-up} which=${2:-all} hosts=("${NODES[@]}")
  case "$which" in
    clio)   hosts=("$CLIO_MGMT");;
    urania) hosts=("$URANIA_MGMT");;
    all)    ;;
    *) die "comfyui up|down [clio|urania]";;
  esac
  case "$action" in
    up)   for h in "${hosts[@]}"; do on "$h" 'sudo systemctl stop clio-vllm clio-vllm-shard; sudo systemctl start clio-comfyui'; done
          say "ComfyUI starting on: ${hosts[*]} (:${COMFYUI_PORT}). First start pulls a ~7.5GB image."
          say "Any vLLM server on those nodes was stopped (Conflicts=) — 'clusterctl mode <node> llm' puts it back."
          say "Parallelism: add ComfyUI-Distributed via Manager (host on one, add the other as Remote worker — docs/comfyui.md)";;
    down) for h in "${hosts[@]}"; do on "$h" 'sudo systemctl stop clio-comfyui 2>/dev/null || true'; done; say "ComfyUI stopped on: ${hosts[*]}";;
    *) die "comfyui up|down [clio|urania]";;
  esac
}

# Change the management-LAN MTU on the nodes, verifying before persisting.
#
# Order matters and the tool enforces the safe half: each node gets the new MTU LIVE ONLY, with a
# timer armed to undo it. ceres then sends a DF-set ping at the full new size. Only if that packet
# survives the round trip does the change get committed and persisted; otherwise the node reverts
# itself and nothing is left broken. This is the failure that took urania off the network on
# 2026-08-07 — cheap to cause, expensive to fix blind.
#
# The half the tool CANNOT do: the switch must forward the frames first (UniFi ships with Jumbo
# Frames off), and ceres's own en0 must match, or the verification ping fails for the wrong reason.
cmd_lan_mtu() {
  local mtu=${1:?"lan-mtu <mtu> [clio|urania]"} which=${2:-all} hosts=("${NODES[@]}")
  case "$which" in
    clio) hosts=("$CLIO_MGMT");; urania) hosts=("$URANIA_MGMT");; all) ;;
    *) die "lan-mtu <mtu> [clio|urania]";;
  esac

  local mine
  mine=$(ifconfig "$(route -n get "${hosts[0]}" 2>/dev/null | awk '/interface:/{print $2}')" 2>/dev/null | awk '/mtu/{for(i=1;i<=NF;i++) if($i=="mtu") print $(i+1)}' | head -1)
  if [ -n "${mine:-}" ] && [ "$mine" -lt "$mtu" ] 2>/dev/null; then
    err "this machine's own interface is MTU $mine, below the $mtu you are setting."
    die "The verification ping could not succeed. Raise it first (macOS: sudo ifconfig <if> mtu $mtu)."
  fi

  for h in "${hosts[@]}"; do
    say "[$h] applying MTU $mtu (live, auto-revert armed)"
    scp -q "${SSH_OPTS[@]}" "$REPO_ROOT/scripts/set-lan-mtu.sh" "$SSH_USER@$h:/tmp/set-lan-mtu.sh"
    on "$h" "sudo cp /tmp/set-lan-mtu.sh /opt/clio/scripts/ && sudo chmod +x /opt/clio/scripts/set-lan-mtu.sh
             sudo CLUSTER_DIR=/opt/clio bash /opt/clio/scripts/set-lan-mtu.sh $mtu" || { err "[$h] apply failed"; continue; }
    # Verify FROM THE NODE, pinging this machine back, rather than from here.
    #
    # macOS's ping cannot build an IP datagram larger than 8192 bytes — `sendto: Message too long`,
    # a LOCAL EMSGSIZE that fires even with fragmentation allowed and even though the route reports
    # MTU 9000. It is a limit of the raw-socket path in the ping utility, not of the interface: the
    # macOS *kernel* happily emits 9014-byte frames (it answers a 8972-byte ping from a node, and
    # 800 MB TCP transfers run clean at MTU 9000). Testing from here therefore fails every jumbo
    # check on a Mac and reports a healthy network as broken. Linux's ping has no such cap, so the
    # node pings back to $SSH_CLIENT — same wire, same frame size, trustworthy answer.
    local probe="ping -c 3 -W 2 -M do -s $((mtu - 28)) \$(echo \$SSH_CLIENT | awk '{print \$1}')"
    if on "$h" "$probe >/dev/null 2>&1"; then
      say "[$h] full-size frame survives — committing"
      on "$h" "sudo CLUSTER_DIR=/opt/clio bash /opt/clio/scripts/set-lan-mtu.sh $mtu --commit"
    else
      err "[$h] a $mtu-byte frame did NOT get through. Leaving it to auto-revert."
      err "     Enable Jumbo Frames on the UniFi switch, then re-run. No change persisted."
    fi
  done
  say "Current: $(for h in "${hosts[@]}"; do printf '%s=%s ' "${h%%.*}" "$(on "$h" 'cat /sys/class/net/$(ip -4 -o route get '"${LAN_GATEWAY:-10.10.10.1}"' | awk "{for(i=1;i<=NF;i++) if(\$i==\"dev\") print \$(i+1)}")/mtu' 2>/dev/null)"; done)"
}

# Push the node's HTTPS cert + the CA cert (for verifying clients) and (re)configure nginx.
# The CA PRIVATE key stays on ceres — a node never needs it and should never hold it.
cmd_nginx() {
  local action=${1:-deploy} which=${2:-all} hosts=("${NODES[@]}")
  local ca_dir=${CA_DIR:-$HOME/.clio/ca}
  case "$which" in
    clio)   hosts=("$CLIO_MGMT");;
    urania) hosts=("$URANIA_MGMT");;
    all)    ;;
    *) die "nginx deploy|status [clio|urania]";;
  esac
  case "$action" in
    deploy)
      [ -f "$ca_dir/ca.crt" ] || die "no CA — run: clio-pki init && clio-pki server clio && clio-pki server urania"
      for h in "${hosts[@]}"; do
        local short=${h%%.*} fqdn
        fqdn="$short.${CLUSTER_DOMAIN:-cgk.sh}"
        [ -f "$ca_dir/certs/$fqdn.crt" ] || die "no server cert for $fqdn — run: clio-pki server $short"
        say "Deploying certs + nginx to $h"
        on "$h" 'rm -rf /tmp/clio-pki && mkdir -p /tmp/clio-pki && chmod 700 /tmp/clio-pki'
        scp -q "${SSH_OPTS[@]}" "$ca_dir/ca.crt"                "$SSH_USER@$h:/tmp/clio-pki/ca.crt"
        scp -q "${SSH_OPTS[@]}" "$ca_dir/certs/$fqdn.crt"        "$SSH_USER@$h:/tmp/clio-pki/server.crt"
        scp -q "${SSH_OPTS[@]}" "$ca_dir/private/$fqdn.key"      "$SSH_USER@$h:/tmp/clio-pki/server.key"
        on "$h" 'rm -rf /tmp/nginx-src && mkdir -p /tmp/nginx-src'
        scp -qr "${SSH_OPTS[@]}" "$REPO_ROOT/cluster/nginx/comfyui.conf.tmpl" "$REPO_ROOT/cluster/nginx/errors" \
                "$SSH_USER@$h:/tmp/nginx-src/"
        scp -q  "${SSH_OPTS[@]}" "$REPO_ROOT/scripts/bootstrap/45-nginx.sh"   "$SSH_USER@$h:/tmp/45-nginx.sh"
        on "$h" 'sudo mkdir -p /opt/clio/nginx && sudo rm -rf /opt/clio/nginx/errors
                 sudo cp -r /tmp/nginx-src/comfyui.conf.tmpl /tmp/nginx-src/errors /opt/clio/nginx/
                 sudo cp /tmp/45-nginx.sh /opt/clio/scripts/bootstrap/ && sudo chmod +x /opt/clio/scripts/bootstrap/45-nginx.sh
                 rm -rf /tmp/nginx-src /tmp/45-nginx.sh
                 sudo CLUSTER_DIR=/opt/clio bash /opt/clio/scripts/bootstrap/45-nginx.sh'
      done
      say "Done. Reach it at https://<node>.${CLUSTER_DOMAIN:-cgk.sh}/ with a client certificate."
      say "No cert on this Mac yet?  clio-pki client <name>   then import the .p12 (docs/security.md)";;
    status)
      for h in "${hosts[@]}"; do
        echo "── $h ──"
        on "$h" 'echo -n "  nginx: "; systemctl is-active nginx 2>/dev/null
                 echo -n "  cert expires: "; openssl x509 -enddate -noout -in /etc/clio-pki/server.crt 2>/dev/null | cut -d= -f2 || echo "(none)"
                 echo -n "  8188 binding: "; sudo ss -tlnp 2>/dev/null | awk "/:8188 /{print \$4; exit}"' 2>/dev/null || echo "  (unreachable)"
      done;;
    *) die "nginx deploy|status [clio|urania]";;
  esac
}

cmd_status() {
  for h in "${NODES[@]}"; do
    echo "── $h ──"
    on "$h" 'echo -n "  GPU: "; nvidia-smi --query-gpu=name,memory.used,memory.total,utilization.gpu --format=csv,noheader 2>/dev/null
             echo -n "  vllm: "; systemctl is-active clio-vllm 2>/dev/null
             echo -n "  comfyui: "; systemctl is-active clio-comfyui 2>/dev/null
             echo "  containers: $(docker ps --format "{{.Names}}" 2>/dev/null | tr "\n" " ")"
             echo "  fabric active_mtu: $(for d in mlx5_0 mlx5_1 mlx5_2 mlx5_3; do ibv_devinfo -d $d 2>/dev/null | awk "/active_mtu/{printf \"%s \", \$2}"; done)"' 2>/dev/null || echo "  (unreachable)"
  done
  echo "── gateway ($HEAD:$GATEWAY_PORT) ──"
  on "$HEAD" "echo -n '  shard: '; systemctl is-active clio-vllm-shard 2>/dev/null; echo -n '  gateway: '; systemctl is-active clio-gateway 2>/dev/null; curl -fsS http://localhost:$GATEWAY_PORT/health/liveliness >/dev/null 2>&1 && echo '  health: ok' || echo '  health: DOWN'"
}

cmd_nccl_test() {
  say "RoCE per-rail bandwidth (ib_write_bw). Target ~190 Gb/s aggregate; ~22-24 GB/s/cable in NCCL."
  on "$URANIA_MGMT" 'pkill -f ib_write_bw 2>/dev/null; (ib_write_bw -d mlx5_1 -F --report_gbits >/dev/null 2>&1 &) ; sleep 1'
  on "$CLIO_MGMT" "ib_write_bw -d mlx5_1 -F --report_gbits $URANIA_FABRIC 2>&1 | tail -5" || true
  echo "For the full NCCL all_reduce check (look for 'NET/IB', NOT 'NET/Socket'), run a sharded model with NCCL_DEBUG=INFO and read the logs — see docs/networking.md."
}

cmd_logs() {
  local svc=${1:-vllm} node=${2:-$CLIO_MGMT}
  case "$svc" in
    vllm)    on "$node" 'sudo journalctl -u clio-vllm -n 80 -f';;
    shard)   on "$HEAD" 'sudo journalctl -u clio-vllm-shard -n 80 -f';;
    gateway) on "$HEAD" 'sudo journalctl -u clio-gateway -n 80 -f';;
    comfyui) on "$node" 'sudo journalctl -u clio-comfyui -n 80 -f';;
    *) die "logs vllm|shard|gateway|comfyui [node]";;
  esac
}

cmd_models() {
  echo "Profiles (cluster/profiles/*.env):"
  for f in "$REPO_ROOT"/cluster/profiles/*.env; do
    local n m mo; n=$(basename "$f" .env)
    m=$(grep -m1 '^VLLM_MODEL=' "$f" | cut -d= -f2-); mo=$(grep -m1 '^PROFILE_MODE=' "$f" | cut -d= -f2-)
    printf "  %-20s %-8s %s\n" "$n" "[$mo]" "$m"
  done
  echo "Gateway model names for 'clusterctl use': local-coder, local-big, claude-opus-4-8, claude-sonnet-4-6"
}

case "${1:-}" in
  bootstrap) cmd_bootstrap;;
  status)    cmd_status;;
  models)    cmd_models;;
  serve|up)  shift; cmd_serve "${1:?profile required}";;
  shard)     shift; cmd_shard "${1:?profile required}";;
  down)      cmd_down;;
  use)       shift; cmd_use "${1:?model required}";;
  mode)      shift; cmd_mode "$@";;
  comfyui)   shift; cmd_comfyui "$@";;
  nginx)     shift; cmd_nginx "$@";;
  lan-mtu)   shift; cmd_lan_mtu "$@";;
  preflight) shift; cmd_preflight "$@";;
  nccl-test) cmd_nccl_test;;
  logs)      shift; cmd_logs "$@";;
  *) sed -n '2,20p' "$0"; exit 1;;
esac
