# Secrets — never commit
cluster/gateway/gateway.env
**/secrets.env
# PKI. The CA lives in ~/.clio/ca (outside this repo) by design; these are belt-and-braces so a
# stray copy can never be committed. A leaked CA key = anyone can mint a client cert and get in.
**/*.key
**/*.p12
**/*.password
ca/
# Runtime state written on nodes (not in this repo, but guard anyway)
**/active-profile.env
**/shard-profile.env
# Local clones built on nodes
spark-vllm-docker/
comfyui-docker/
# Animation pipeline: generated candidates are regenerable (runs.jsonl + PNG metadata); only approved sheet/ images are canon
projects/*/characters/*/candidates/
__pycache__/
projects/*/characters/*/3d/*
!projects/*/characters/*/3d/turnaround_sheet.png
!projects/*/characters/*/3d/build.json
# macOS Finder metadata
.DS_Store
