# Profile: capability model — GPT-OSS-120B (MXFP4) — scale-out (per Spark).
# ~50 tok/s, ~120 GB footprint (nearly the whole box). Requires the MXFP4 image and
# the CUTLASS backend, or output is broken on stock vLLM (vLLM #37030). See docs/models.md.
PROFILE_NAME=gpt-oss-120b
PROFILE_MODE=scaleout

VLLM_IMAGE=vllm-node-mxfp4             # built by 20-vllm.sh with --exp-mxfp4
VLLM_MODEL=openai/gpt-oss-120b
VLLM_SERVED_NAME=local-big            # gateway routes "local-big" here
VLLM_MAX_LEN=131072
VLLM_GPU_UTIL=0.90
VLLM_MAX_SEQS=2                        # near-full memory; keep concurrency low
VLLM_ARGS="--quantization mxfp4 --mxfp4-backend CUTLASS"
