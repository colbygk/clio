# Profile: SCALE-UP (sharded) — one model spanning BOTH Sparks via Ray.
# Use ONLY for models that don't fit in one 119 GB box. Pipeline-parallel (PP=2), NOT
# tensor-parallel — PP is ~2.2x faster over the 200G link here (StorageReview 2026-05-11).
# Expect ~10-15 tok/s on a 235B-class model: this is a CAPACITY mode, not a speed mode.
PROFILE_NAME=shard-qwen3-235b
PROFILE_MODE=shard                     # runs on HEAD only; spans both nodes

VLLM_IMAGE=vllm-node
VLLM_MODEL=RedHatAI/Qwen3-VL-235B-A22B-Instruct-NVFP4
VLLM_SERVED_NAME=local-big            # reuse the gateway "local-big" alias
# The model's native maximum. Each node holds KV for only its half of the 94 layers (~47 KB/token
# in fp8); at 0.85 that left ~31 GiB per node, 654,608 tokens of KV at this length (2026-11-06), 2.5 full-length
# requests at once.
# fp8, not nvfp4: vLLM's FP4 KV kernels are sm100-only and refuse the GB10 (sm_121).
VLLM_MAX_LEN=262144
# 0.85 needs ~102 GiB free at startup. Until 2026-11-06 DGX OS boot options reserved 24 GiB of
# hugepages and capped this at ~0.71 (docs/state.md, "Kernel command line"); free page cache
# (clusterctl freemem) before starting if the check still fails.
VLLM_GPU_UTIL=0.85
# PP=2/TP=1 across the two nodes via Ray; serve-shard.sh names the nodes (autodiscovery finds none).
# Patches applied inside the containers before launch (cluster/vllm-mods/).
VLLM_MODS="fix-qwen3-vl-moe-arch"
# Tool calling: Claude Code sends tools on every request, and vLLM refuses them (400, '"auto" tool
# choice requires --enable-auto-tool-choice') unless a parser is named. Qwen3 instruct emits Hermes-style
# <tool_call> blocks.
VLLM_ARGS="--pipeline-parallel-size 2 --tensor-parallel-size 1 --distributed-executor-backend ray --kv-cache-dtype fp8 --enable-auto-tool-choice --tool-call-parser hermes"
