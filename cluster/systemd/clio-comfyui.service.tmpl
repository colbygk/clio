# ComfyUI on a node (template — 30-comfyui.sh fills __REPO__/__COMPOSE_FILE__). On demand only.
#
# Mutually exclusive with the vLLM units: one 119 GiB unified-memory pool serves both the GPU and
# the system, so a model server and ComfyUI cannot coexist (an OOM here freezes the whole box).
# Conflicts= makes the swap atomic — `systemctl start clio-comfyui` stops vLLM first, and starting
# vLLM again stops ComfyUI. Drive it with `clusterctl mode <node> llm|comfy|off`.
[Unit]
Description=clio cluster - ComfyUI
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
Conflicts=clio-vllm.service clio-vllm-shard.service
# The model store may be an NFS mount (clio mounts urania's over the fabric). Docker bind-mounts
# basedir recursively at container start, so the NFS mounts must already be up or the container
# sees empty dirs. On the node that OWNS the store these paths are plain directories on / and this
# resolves to -.mount, which is always active — so the same unit works on both nodes.
RequiresMountsFor=__REPO__/basedir/models __REPO__/basedir/input

[Service]
Type=simple
# On GB10 the GPU and CPU share one memory pool, and CUDA reports free VRAM as free SYSTEM memory:
# vram_free tracks ram_free exactly. Page cache therefore counts AGAINST the GPU. Reading models
# across the NFS share fills cache with tens of GiB, and the next model load fails on its FIRST
# allocation with "Allocation on device 0 would exceed allowed memory" while `free` still shows
# ~89 GiB "available" — the allocator does not force reclaim. Start from a clean slate; the cost is
# re-reading the models, ~7s for 10 GiB over RDMA.
ExecStartPre=/bin/sh -c 'sync; echo 3 > /proc/sys/vm/drop_caches'
WorkingDirectory=__REPO__
ExecStart=/usr/bin/docker compose -f __COMPOSE_FILE__ up
ExecStop=/usr/bin/docker compose -f __COMPOSE_FILE__ down
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
