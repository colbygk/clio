# ComfyUI behind nginx with mutual TLS (template — 45-nginx.sh fills the __PLACEHOLDERS__).
#
# The only way in is TLS with a client certificate signed by the cluster CA. ComfyUI itself binds
# 127.0.0.1 only (see 30-comfyui.sh), so this proxy is not merely the front door — it is the ONLY
# door. That matters: ComfyUI has no authentication of its own and custom nodes execute arbitrary
# code, which is exactly what the Apr-2026 botnet swept the internet for.
#
# Two doors, one per ComfyUI profile (docs/comfyui-profiles.md). Only one profile runs at a time,
# so the other door answers with the "not answering" page:
#   :443   studio   -> 127.0.0.1:__PORT__          any cluster client certificate
#   :8443  private  -> 127.0.0.1:__PRIVATE_PORT__  only certificates whose CN starts "private-"
# The separate port is deliberate: it is a separate browser origin, so tabs, history and other
# per-site state from the private UI never reappear in the studio one.

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name __FQDN__ __HOST__;
    # Nothing is served over plaintext; bounce to TLS. (No ACME dance to preserve — private CA.)
    return 301 https://__FQDN__$request_uri;
}

# ---------------------------------------------------------------- studio
server {
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;
    server_name __FQDN__ __HOST__;

    include /etc/nginx/snippets/clio-comfyui-common.conf;
    # 497 is plain HTTP spoken to the TLS port — send them to the real front door.
    error_page 497 https://__FQDN__$request_uri;

    access_log /var/log/nginx/comfyui.access.log mtls;
    error_log  /var/log/nginx/comfyui.error.log;

    # ---- browsable output gallery ----
    # ComfyUI's Assets sidebar only ever queries `include_tags=models`, so past generations are
    # invisible in the UI even though the backend indexes them; the queue/history panel is
    # per-session and does not survive a restart. This is a plain static listing of the same
    # files, behind the same client-certificate gate. Files are 0644 and dirs 0755, so www-data
    # reads them without any ownership change. Serving them statically also gets byte-range
    # support for free, which is what lets the browser seek in an mp4 instead of downloading it
    # whole before playing.
    location /outputs/ {
        alias __STUDIO_OUTPUT_DIR__/;
        autoindex on;
        autoindex_exact_size off;
        autoindex_localtime on;
    }

    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        include /etc/nginx/snippets/clio-comfyui-proxy.conf;
    }
}

# ---------------------------------------------------------------- private
server {
    listen 8443 ssl http2 default_server;
    listen [::]:8443 ssl http2 default_server;
    server_name __FQDN__ __HOST__;

    include /etc/nginx/snippets/clio-comfyui-common.conf;
    error_page 497 https://__FQDN__:8443$request_uri;

    access_log /var/log/nginx/comfyui-private.access.log mtls;
    error_log  /var/log/nginx/comfyui-private.error.log;

    # The second gate. The handshake already proved the certificate is ours; this narrows it to the
    # private-* ones ($clio_private_client is a map in conf.d/10-websocket-upgrade.conf). The check
    # sits in each location rather than at server level: a server-level `return` would also catch
    # the internal redirect to /_error.html and loop.
    location /outputs/ {
        if ($clio_private_client = 0) { return 403; }
        alias __PRIVATE_OUTPUT_DIR__/;
        autoindex on;
        autoindex_exact_size off;
        autoindex_localtime on;
    }

    location / {
        if ($clio_private_client = 0) { return 403; }
        proxy_pass http://127.0.0.1:__PRIVATE_PORT__;
        include /etc/nginx/snippets/clio-comfyui-proxy.conf;
    }
}
