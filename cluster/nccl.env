# NCCL / RoCE tuning for the clio<->urania fabric. Applied in sharded (scale-up) mode.
# eugr's launch-cluster.sh auto-detects topology, but these are the load-bearing safety knobs
# the research flagged. Verified facts for THIS hardware (2026-06-17):
#   - RDMA devices: mlx5_0..mlx5_3  ->  enp1s0f0np0, enp1s0f1np1, enP2p1s0f0np0, enP2p1s0f1np1
#   - GPUDirect RDMA is UNSUPPORTED on GB10 by design -> expect NCCL log "NET/IB" WITHOUT "/GDRDMA".
#     That is correct, not a misconfiguration. Realistic ceiling ~22-24 GB/s per cable.

# Drive ALL FOUR rails (multi-rail), NOT Linux bonding (bonding/LACP breaks RDMA QP spread).
NCCL_IB_HCA=mlx5_0,mlx5_1,mlx5_2,mlx5_3

# Bootstrap/OOB TCP must ride a fabric NIC, never the 1GbE/WiFi management port.
NCCL_SOCKET_IFNAME=enp1s0f1np1
GLOO_SOCKET_IFNAME=enp1s0f1np1

NCCL_IB_DISABLE=0          # use the IB-verbs (RoCEv2) transport
NCCL_NET_PLUGIN=none       # CRITICAL: bundled OFI plugin fails on GB10 -> silent TCP fallback (~1-3 GB/s)
NCCL_CROSS_NIC=0           # rail-respecting: keep each flow on its own rail
NCCL_NVLS_ENABLE=0         # avoid the NCCL 2.30.4 NVLS multi-Spark hang (issue #2167)

# Do NOT set NCCL_IB_GID_INDEX. NCCL >=2.21 auto-selects the RoCEv2 GID; forcing 3 is stale advice
# and can cause "ibv_modify_qp Invalid argument". Only set it (after `show_gids`) if NCCL errors.

# Uncomment to debug the data path (look for "NET/IB" vs "NET/Socket"):
# NCCL_DEBUG=INFO
